#property copyright "IAN XAU AI"
#property version   "1.00"
#property strict

#include <Trade/Trade.mqh>

CTrade trade;

//========================= INPUTS ===================================

input double LotSize            = 0.10;

input int    FastEMA            = 7;
input int    MediumEMA          = 21;
input int    SlowEMA            = 55;

input int    StopLossPoints     = 300;
input int    TakeProfitPoints   = 600;

input bool   Use_EMACross_Exit  = true;
input bool   OnlyOnePosition    = true;

input ulong  MagicNumber        = 714714;

//========================= GLOBALS ==================================

int FastHandle;
int MediumHandle;
int SlowHandle;

datetime LastBarTime = 0;

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);

   FastHandle = iMA(
      _Symbol,
      PERIOD_CURRENT,
      FastEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   MediumHandle = iMA(
      _Symbol,
      PERIOD_CURRENT,
      MediumEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   SlowHandle = iMA(
      _Symbol,
      PERIOD_CURRENT,
      SlowEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   if(FastHandle == INVALID_HANDLE ||
      MediumHandle == INVALID_HANDLE ||
      SlowHandle == INVALID_HANDLE)
   {
      Print("ERROR: Could not create EMA indicators.");
      return(INIT_FAILED);
   }

   Print("=================================");
   Print("714 EA INITIALIZED");
   Print("Symbol: ", _Symbol);
   Print("Timeframe: ", EnumToString(_Period));
   Print("Lot Size: ", LotSize);
   Print("Magic Number: ", MagicNumber);
   Print("=================================");

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(FastHandle != INVALID_HANDLE)
      IndicatorRelease(FastHandle);

   if(MediumHandle != INVALID_HANDLE)
      IndicatorRelease(MediumHandle);

   if(SlowHandle != INVALID_HANDLE)
      IndicatorRelease(SlowHandle);

   Print("714 EA stopped.");
}

//+------------------------------------------------------------------+
//| Check if new candle                                              |
//+------------------------------------------------------------------+
bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);

   if(currentBarTime != LastBarTime)
   {
      LastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| Count EA positions                                               |
//+------------------------------------------------------------------+
int CountMyPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && magic == (long)MagicNumber)
         count++;
   }

   return count;
}

//+------------------------------------------------------------------+
//| Close EA positions                                               |
//+------------------------------------------------------------------+
void CloseMyPositions()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && magic == (long)MagicNumber)
      {
         trade.PositionClose(ticket);
      }
   }
}

//+------------------------------------------------------------------+
//| Get EMA values                                                   |
//+------------------------------------------------------------------+
bool GetEMAValues(
   double &fastCurrent,
   double &fastPrevious,
   double &mediumCurrent,
   double &mediumPrevious,
   double &slowCurrent,
   double &slowPrevious
)
{
   double fastBuffer[2];
   double mediumBuffer[2];
   double slowBuffer[2];

   ArraySetAsSeries(fastBuffer, true);
   ArraySetAsSeries(mediumBuffer, true);
   ArraySetAsSeries(slowBuffer, true);

   if(CopyBuffer(FastHandle, 0, 1, 2, fastBuffer) != 2)
      return false;

   if(CopyBuffer(MediumHandle, 0, 1, 2, mediumBuffer) != 2)
      return false;

   if(CopyBuffer(SlowHandle, 0, 1, 2, slowBuffer) != 2)
      return false;

   // Closed candle values
   fastCurrent    = fastBuffer[0];
   fastPrevious   = fastBuffer[1];

   mediumCurrent  = mediumBuffer[0];
   mediumPrevious = mediumBuffer[1];

   slowCurrent    = slowBuffer[0];
   slowPrevious   = slowBuffer[1];

   return true;
}

//+------------------------------------------------------------------+
//| Open BUY                                                         |
//+------------------------------------------------------------------+
void OpenBuy()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   if(ask <= 0)
      return;

   double sl = ask - StopLossPoints * _Point;
   double tp = ask + TakeProfitPoints * _Point;

   sl = NormalizeDouble(sl, _Digits);
   tp = NormalizeDouble(tp, _Digits);

   bool result = trade.Buy(
      LotSize,
      _Symbol,
      ask,
      sl,
      tp,
      "714 BUY"
   );

   if(result)
   {
      Print(
         "714 BUY OPENED | Entry: ",
         ask,
         " | SL: ",
         sl,
         " | TP: ",
         tp
      );
   }
   else
   {
      Print(
         "BUY FAILED | Error: ",
         GetLastError(),
         " | Retcode: ",
         trade.ResultRetcode()
      );
   }
}

//+------------------------------------------------------------------+
//| Open SELL                                                        |
//+------------------------------------------------------------------+
void OpenSell()
{
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(bid <= 0)
      return;

   double sl = bid + StopLossPoints * _Point;
   double tp = bid - TakeProfitPoints * _Point;

   sl = NormalizeDouble(sl, _Digits);
   tp = NormalizeDouble(tp, _Digits);

   bool result = trade.Sell(
      LotSize,
      _Symbol,
      bid,
      sl,
      tp,
      "714 SELL"
   );

   if(result)
   {
      Print(
         "714 SELL OPENED | Entry: ",
         bid,
         " | SL: ",
         sl,
         " | TP: ",
         tp
      );
   }
   else
   {
      Print(
         "SELL FAILED | Error: ",
         GetLastError(),
         " | Retcode: ",
         trade.ResultRetcode()
      );
   }
}

//+------------------------------------------------------------------+
//| Main trading function                                            |
//+------------------------------------------------------------------+
void OnTick()
{
   // Only evaluate once per new candle
   if(!IsNewBar())
      return;

   double fastCurrent;
   double fastPrevious;

   double mediumCurrent;
   double mediumPrevious;

   double slowCurrent;
   double slowPrevious;

   if(!GetEMAValues(
      fastCurrent,
      fastPrevious,
      mediumCurrent,
      mediumPrevious,
      slowCurrent,
      slowPrevious
   ))
   {
      Print("ERROR: Could not read EMA values.");
      return;
   }

   //===============================================================
   // BUY CONDITION
   //
   // 21 EMA must be above 55 EMA
   // 7 EMA crosses ABOVE both 21 and 55
   //===============================================================

   bool buyTrend =
      mediumCurrent > slowCurrent;

   bool buyCross =
      fastPrevious <= mediumPrevious &&
      fastCurrent  >  mediumCurrent &&
      fastCurrent  >  slowCurrent;

   //===============================================================
   // SELL CONDITION
   //
   // 21 EMA must be below 55 EMA
   // 7 EMA crosses BELOW both 21 and 55
   //===============================================================

   bool sellTrend =
      mediumCurrent < slowCurrent;

   bool sellCross =
      fastPrevious >= mediumPrevious &&
      fastCurrent  <  mediumCurrent &&
      fastCurrent  <  slowCurrent;

   //===============================================================
   // EXIT ON OPPOSITE EMA CROSS
   //===============================================================

   if(Use_EMACross_Exit)
   {
      int positions = CountMyPositions();

      if(positions > 0)
      {
         bool bearishCross =
            fastPrevious >= mediumPrevious &&
            fastCurrent  < mediumCurrent;

         bool bullishCross =
            fastPrevious <= mediumPrevious &&
            fastCurrent  > mediumCurrent;

         if(bearishCross || bullishCross)
         {
            Print("EMA exit signal detected.");
            CloseMyPositions();
         }
      }
   }

   //===============================================================
   // ONE POSITION ONLY
   //===============================================================

   if(OnlyOnePosition)
   {
      if(CountMyPositions() > 0)
         return;
   }

   //===============================================================
   // EXECUTE BUY
   //===============================================================

   if(buyTrend && buyCross)
   {
      Print("714 BUY SIGNAL");
      OpenBuy();
      return;
   }

   //===============================================================
   // EXECUTE SELL
   //===============================================================

   if(sellTrend && sellCross)
   {
      Print("714 SELL SIGNAL");
      OpenSell();
      return;
   }
}
