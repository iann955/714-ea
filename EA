
 // IAN_XAU_Tick_Scalper.mq5
 // Version 1.00 - DEMO TESTING ONLY
 #property strict
 #property version "1.00"

 #include <Trade/Trade.mqh>
 CTrade trade;

 input ulong MagicNumber = 7142026;
 input bool AllowTrading = false;
 input double RiskPercent = 1.0;
 input int MaxSpreadPoints = 100;
 input int SlippagePoints = 30;
 input int TickLookback = 5;
 input double MinMomentumPoints = 30;
 input int StopLossPoints = 500;
 input int TakeProfitPoints = 750;
 input double MaxDailyLossPercent = 3.0;
 input double ProfitTargetMoney = 0.50;
 input bool UseProfitTarget = true;
 input ENUM_TIMEFRAMES SignalTimeframe = PERIOD_M1;

 double prices[];
 int ticks = 0;
 datetime lastBar = 0;
 int currentDay = -1;
 double startEquity = 0;
 bool dailyBlocked = false;

 int OnInit()
 {
    if(RiskPercent <= 0 || RiskPercent > 5 ||
       TickLookback < 2 || StopLossPoints <= 0)
       return INIT_PARAMETERS_INCORRECT;

    ArrayResize(prices, TickLookback + 1);
    ArrayInitialize(prices, 0);

    trade.SetExpertMagicNumber(MagicNumber);
    trade.SetDeviationInPoints(SlippagePoints);
    trade.SetTypeFillingBySymbol(_Symbol);

    ResetDay();
    Print("IAN XAU Tick Scalper loaded. Demo testing only.");
    return INIT_SUCCEEDED;
 }

 void OnTick()
 {
    ResetDay();
    RecordTick();
    ManageProfitExit();

    if(!AllowTrading || dailyBlocked || DailyLossReached())
       return;

    if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) ||
       !MQLInfoInteger(MQL_TRADE_ALLOWED))
       return;

    if(CountPositions() >= 1 || !SpreadOK())
       return;

    datetime bar = iTime(_Symbol, SignalTimeframe, 0);
    if(bar <= 0 || bar == lastBar)
       return;

    int signal = GetSignal();
    if(signal == 0)
       return;

    if(OpenTrade(signal))
       lastBar = bar;
 }

 void ResetDay()
 {
    MqlDateTime t;
    TimeToStruct(TimeCurrent(), t);

    if(currentDay != t.day_of_year)
    {
       currentDay = t.day_of_year;
       startEquity = AccountInfoDouble(ACCOUNT_EQUITY);
       dailyBlocked = false;
    }
 }

 bool DailyLossReached()
 {
    if(startEquity <= 0)
       return false;

    double equity = AccountInfoDouble(ACCOUNT_EQUITY);
    double loss = (startEquity - equity) / startEquity * 100.0;

    if(loss >= MaxDailyLossPercent)
    {
       dailyBlocked = true;
       Print("Daily loss limit reached. New trades blocked.");
       return true;
    }
    return false;
 }

 void RecordTick()
 {
    MqlTick t;
    if(!SymbolInfoTick(_Symbol, t) || t.bid <= 0)
       return;

    for(int i = ArraySize(prices) - 1; i > 0; i--)
       prices[i] = prices[i - 1];

    prices[0] = t.bid;
    if(ticks < ArraySize(prices))
       ticks++;
 }

 int GetSignal()
 {
    if(ticks < TickLookback + 1)
       return 0;

    double move = (prices[0] - prices[TickLookback]) / _Point;

    if(move >= MinMomentumPoints)
       return 1;

    if(move <= -MinMomentumPoints)
       return -1;

    return 0;
 }

 bool SpreadOK()
 {
    MqlTick t;
    if(!SymbolInfoTick(_Symbol, t) || t.ask <= 0 || t.bid <= 0)
       return false;

    return ((t.ask - t.bid) / _Point <= MaxSpreadPoints);
 }

 int CountPositions()
 {
    int count = 0;

    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
       ulong ticket = PositionGetTicket(i);
       if(ticket == 0)
          continue;

       if((ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
          count++;
    }

    return count;
 }

 double GetVolume(ENUM_ORDER_TYPE type, double entry, double sl)
 {
    double equity = AccountInfoDouble(ACCOUNT_EQUITY);
    double riskMoney = equity * RiskPercent / 100.0;

    double oneLotResult = 0;
    if(!OrderCalcProfit(type, _Symbol, 1.0, entry, sl, oneLotResult))
       return 0;

    double lossPerLot = MathAbs(oneLotResult);
    if(lossPerLot <= 0)
       return 0;

    double raw = riskMoney / lossPerLot;
    double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
    double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
    double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

    if(step <= 0 || minLot <= 0 || raw < minLot)
       return 0;

    double volume = MathFloor(raw / step) * step;
    volume = NormalizeDouble(volume, 4);

    if(volume < minLot || volume > maxLot)
       return 0;

    double minLotResult = 0;
    if(!OrderCalcProfit(type, _Symbol, minLot, entry, sl, minLotResult))
       return 0;

    if(MathAbs(minLotResult) > riskMoney + 0.01)
       return 0;

    return volume;
 }

 bool OpenTrade(int signal)
 {
    MqlTick t;
    if(!SymbolInfoTick(_Symbol, t))
       return false;

    ENUM_ORDER_TYPE type = signal > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
    double entry = signal > 0 ? t.ask : t.bid;

    int stopLevel = (int)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
    int slPoints = MathMax(StopLossPoints, stopLevel + 2);
    int tpPoints = MathMax(TakeProfitPoints, stopLevel + 2);

    double sl = signal > 0 ?
       entry - slPoints * _Point : entry + slPoints * _Point;

    double tp = signal > 0 ?
       entry + tpPoints * _Point : entry - tpPoints * _Point;

    sl = NormalizeDouble(sl, _Digits);
    tp = NormalizeDouble(tp, _Digits);

    double volume = GetVolume(type, entry, sl);
    if(volume <= 0)
    {
       Print("Trade skipped: minimum volume exceeds risk budget.");
       return false;
    }

    double margin = 0;
    if(!OrderCalcMargin(type, _Symbol, volume, entry, margin))
       return false;

    if(margin <= 0 ||
       margin > AccountInfoDouble(ACCOUNT_MARGIN_FREE) * 0.8)
    {
       Print("Trade skipped: insufficient free margin.");
       return false;
    }

    bool ok = signal > 0 ?
       trade.Buy(volume, _Symbol, 0, sl, tp, "IAN XAU BUY") :
       trade.Sell(volume, _Symbol, 0, sl, tp, "IAN XAU SELL");

    if(!ok)
       Print("Order failed: ", trade.ResultRetcodeDescription());

    return ok;
 }

 void ManageProfitExit()
 {
    if(!UseProfitTarget || ProfitTargetMoney <= 0)
       return;

    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
       ulong ticket = PositionGetTicket(i);
       if(ticket == 0)
          continue;

       if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
          continue;

       if(PositionGetString(POSITION_SYMBOL) != _Symbol)
          continue;

       double netEstimate = PositionGetDouble(POSITION_PROFIT) +
                            PositionGetDouble(POSITION_SWAP);

       // Commission may not be reflected here; this is an estimate.
       if(netEstimate >= ProfitTargetMoney)
       {
          if(!trade.PositionClose(ticket))
             Print("Close failed: ", trade.ResultRetcodeDescription());
       }
    }
 }
